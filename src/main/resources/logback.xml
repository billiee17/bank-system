<configuration>
  <!-- Thư mục chứa file log; đổi bằng: java -DLOG_DIR=/duong/dan -jar ... (mặc định: ./logs) -->
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

  <!-- Định dạng chung: thời gian | mức log | luồng | logger | nội dung -->
  <property name="LOG_PATTERN"
            value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{20} - %msg%n"/>

  <!-- 1) Ghi ra console -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- 2) Ghi vào tệp vật lý logs/bank-system.log -->
  <appender name="FILE" class="ch.qos.logback.core.FileAppender">
    <file>${LOG_DIR}/bank-system.log</file>
    <append>true</append>
    <immediateFlush>true</immediateFlush>
    <encoder>
      <charset>UTF-8</charset>
      <pattern>${LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <!-- Mã nguồn của dự án: DEBUG trở lên để theo dõi chi tiết -->
  <logger name="com.practice.bank" level="DEBUG"/>

  <!-- Thư viện bên ngoài: chỉ INFO trở lên -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="FILE"/>
  </root>
</configuration>
